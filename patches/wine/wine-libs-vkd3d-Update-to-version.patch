+static bool is_input_register_with_loop_relative_addressing(struct vsir_operand *reg)
+{
+    if (reg->type != VKD3DSPR_INPUT)
+        return false;
+    if (!reg->idx_count || !reg->idx[0].rel_addr)
+        return false;
+    return reg->idx[0].rel_addr->reg.type == VKD3DSPR_LOOP;
+}
