Subject: [PATCH 201/201] winewayland: Implement focus changes through
 pGetWindowStateUpdates.

---
 dlls/win32u/message.c                   |  4 +-
 dlls/winewayland.drv/wayland_keyboard.c | 17 +-------
 dlls/winewayland.drv/waylanddrv.h       |  2 +-
 dlls/winewayland.drv/waylanddrv_main.c  |  1 +
 dlls/winewayland.drv/window.c           | 57 +++++++++++++++++--------
 5 files changed, 46 insertions(+), 35 deletions(-)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 73f27cdbb5b..35ef4ff7330 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2244,7 +2244,7 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
     case WM_WINE_WINDOW_STATE_CHANGED:
     {
         UINT state_cmd = 0, swp_flags = 0;
-        RECT window_rect;
+        RECT window_rect = {0};
         HWND foreground = 0;
 
         if (!user_driver->pGetWindowStateUpdates( hwnd, &state_cmd, &swp_flags, &window_rect, &foreground )) return 0;
@@ -2257,7 +2257,7 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
             if (HIWORD(state_cmd)) NtUserSetActiveWindow( hwnd );
 
             /* make the win32 window restore to the current host window config */
-            set_window_normal_placement( hwnd, window_rect );
+            if (!IsRectEmpty( &window_rect )) set_window_normal_placement( hwnd, window_rect );
 
             /* fallthrough */
         default:
diff --git a/dlls/winewayland.drv/wayland_keyboard.c b/dlls/winewayland.drv/wayland_keyboard.c
index 6d5a4ef332f..7d7baf30087 100644
--- a/dlls/winewayland.drv/wayland_keyboard.c
+++ b/dlls/winewayland.drv/wayland_keyboard.c
@@ -944,17 +944,8 @@ static void keyboard_handle_enter(void *private, struct wl_keyboard *wl_keyboard
 
     if ((surface = data->wayland_surface))
     {
-        /* TODO: Drop the internal message and call NtUserSetForegroundWindow
-         * directly once it's updated to not explicitly deactivate the old
-         * foreground window when both the old and new foreground windows
-         * are in the same non-current thread. */
         if (surface->window.managed)
-        {
-            if (surface->window.minimized)
-                NtUserPostMessage(hwnd, WM_SYSCOMMAND, SC_RESTORE, 0);
-            else
-                NtUserPostMessage(hwnd, WM_WAYLAND_SET_FOREGROUND, 0, 0);
-        }
+            NtUserPostMessage(hwnd, WM_WINE_WINDOW_STATE_CHANGED, 0, 0);
     }
 
     wayland_win_data_release(data);
@@ -1009,12 +1000,8 @@ static void keyboard_handle_leave(void *private, struct wl_keyboard *wl_keyboard
 
         if ((surface = data->wayland_surface))
         {
-            /* TODO: Drop the internal message and call NtUserSetForegroundWindow
-             * directly once it's updated to not explicitly deactivate the old
-             * foreground window when both the old and new foreground windows
-             * are in the same non-current thread. */
             if (surface->window.managed && !wayland_disable_focus_loss())
-                NtUserPostMessage(hwnd, WM_WAYLAND_SET_FOREGROUND, 1, 0);
+                NtUserPostMessage(hwnd, WM_WINE_WINDOW_STATE_CHANGED, 0, 0);
         }
 
         wayland_win_data_release(data);
